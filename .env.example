# ============================================================
# TaiCOL nametool .env 範本
# 只列出程式實際會讀到的變數；測試站 / 正式站需各自一份 .env
# ============================================================

# ---- App ----
APP_NAME=nametool
APP_ENV=production            # 正式站 production（會載入 GA）；測試站 staging；本機 local
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false
APP_URL=https://nametool.taicol.tw   # 測試站 https://staging.taicol.tw；也用於 pdfs 檔案網址與通知信連結

LOG_CHANNEL=stack

# ---- Database (MySQL) ----
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---- Redis（queue / Gemini 每日呼叫次數計數）----
REDIS_CLIENT=phpredis
REDIS_HOST=redis              # docker compose 的 service 名稱
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis        # 匯入 / AI job 由 worker container 執行
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---- Mail ----
# AWS SES：透過 IAM role 取得憑證，不需設定 key
MAIL_MAILER=ses
AWS_DEFAULT_REGION=us-west-2
AWS_BUCKET=email.us-west-2.amazonaws.com
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# 匯入完成 / 更新失敗等通知信收件者
TAICOL_EMAIL=catalogueoflife.taiwan@gmail.com

# ---- TaiCOL 相關服務 ----
TAICOL_ROOT=https://taicol.tw                 # 學名 autocomplete（/get_autocomplete_taxon_by_solr）
TAICOL_API_ROOT=https://api.taicol.tw         # 測試站指向測試 API
TAICOL_API_TOKEN=                             # 需與 API 端 INTERNAL_API_TOKEN 相同
TAICOL_AI_API_ROOT=                           # AI 解析服務（/process-reference、/process-usage）

# 更新服務：UPDATE_SERVICE_ROOT 留空則沿用 TAICOL_API_ROOT（舊行為）
UPDATE_SERVICE_ROOT=
UPDATE_SERVICE_API_KEY=                       # 與更新服務 .env 的 UPDATE_SERVICE_API_KEY 相同
UPDATE_NOTIFY_TOKEN=                          # 與更新服務 .env 的 UPDATE_NOTIFY_TOKEN 相同

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_API_DAILY_LIMIT=1000

# ---- 外部呼叫驗證 ----
BIOTA_TOKEN=                                  # MyNamespaceUsageController 的 token 檢查

# ---- 部署 ----
DEPLOY_STAG_DEST=
DEPLOY_PROD_DEST=