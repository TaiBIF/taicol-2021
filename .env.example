# ============================================================
# TaiCOL nametool .env 範本
# 只列出程式實際會讀到的變數；本機 / 測試站 / 升級測試站 / 正式站各自一份 .env
# 注意：DEPLOY_*、DEV_* 這兩組不能在值後面加註解（deploy.sh / Makefile 會把註解讀進值）
# ============================================================

# ---- App ----
# APP_NAME 會影響 cache / redis / session 的 key 前綴：既有環境不要改（測試站目前是 Laravel），
# 改了會讓所有人被登出、queue 裡排隊的 job 與 AI 每日計數讀不到
APP_NAME=Laravel
APP_ENV=production            # 正式站 production（會載入 GA）；測試站 staging；本機 local
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false               # 測試站目前為 true
APP_URL=https://nametool.taicol.tw   # 測試站 https://staging.taicol.tw；升級測試站 https://staging-upgrade.taicol.tw；也用於 pdfs 檔案網址與通知信連結
ASSET_URL=https://nametool.taicol.tw # 與 APP_URL 相同

LOG_CHANNEL=stack
API_RATE_LIMIT=60             # API 每分鐘上限（每帳號或 IP）；測試站跑 E2E 設 1000

# ---- Database (MySQL) ----
DB_CONNECTION=mysql
DB_HOST=                      # 測試站 mysql-web（gateway 網路）；本機 host.docker.internal
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---- Redis（queue / AI 每日呼叫次數計數）----
REDIS_CLIENT=predis           # stag / prod image 沒有安裝 phpredis extension，必須用 predis
REDIS_HOST=redis              # docker compose 的 service 名稱；升級測試站必須改為 taicol-nametool-upg-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis        # 匯入 / AI job 由 worker container 執行
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# 登入是 Sanctum API token（Bearer），不是 SPA cookie：
# 不要把網站網域設進 SANCTUM_STATEFUL_DOMAINS，否則 API 改走 CSRF 驗證，登入回 419
# SANCTUM_STATEFUL_DOMAINS=

# ---- Mail ----
# AWS SES：透過 IAM role（EC2 instance profile）取得憑證，不需設定 key
MAIL_MAILER=ses
AWS_DEFAULT_REGION=us-west-2
MAIL_FROM_ADDRESS=no-reply@taicol.tw
MAIL_FROM_NAME="${APP_NAME}"

# 匯入完成 / 更新失敗等通知信收件者
TAICOL_EMAIL=catalogueoflife.taiwan@gmail.com

# ---- TaiCOL 相關服務 ----
TAICOL_ROOT=https://taicol.tw                 # 學名 autocomplete（/get_autocomplete_taxon_by_solr）；測試站 https://web-staging.taicol.tw
TAICOL_API_ROOT=https://api.taicol.tw         # 測試站 https://api-staging.taicol.tw
TAICOL_API_TOKEN=                             # 需與 API 端 INTERNAL_API_TOKEN 相同
TAICOL_AI_API_ROOT=                           # AI 解析服務（/process-reference、/process-usage），例：http://nametool-python:8009

# 更新服務：UPDATE_SERVICE_ROOT 留空則沿用 TAICOL_API_ROOT（舊行為）
UPDATE_SERVICE_ROOT=
UPDATE_SERVICE_API_KEY=                       # 與更新服務 .env 的 UPDATE_SERVICE_API_KEY 相同
UPDATE_NOTIFY_TOKEN=                          # 與更新服務 .env 的 UPDATE_NOTIFY_TOKEN 相同（至少 32 字元）

# ---- AI 匯入 ----
AI_IMPORT_ENABLED=true                        # false 時隱藏 AI 匯入入口
GEMINI_API_DAILY_LIMIT=1000                   # AI 每日呼叫上限（變數名稱沿用舊稱）

# ---- 外部呼叫驗證 ----
BIOTA_TOKEN=                                  # MyNamespaceUsageController::biota 的 token；未設定時一律拒絕

# ---- 部署（deploy.sh，只有本機需要；值後面不能加註解）----
# 例：tc-stag:~/taicol-2021/
DEPLOY_STAG_DEST=
# 例：tc-stag:~/nametool-upgrade/
DEPLOY_UPG_DEST=
DEPLOY_PROD_DEST=

# ---- 本機 docker compose（只有升級用 worktree 需要；值後面不能加註解）----
# DEV_PREFIX=taicol-nametool-upgdev
# DEV_IMAGE=taicol-nametool-upgdev:latest
# DEV_APP_PORT=8001
# DEV_REDIS_PORT=6380