# 使用 FPM 版本以支援 Nginx 連線
FROM php:8.2-fpm-alpine

# 1. 安裝系統依賴 (包含修復 IntlChar 報錯所需的 icu-dev)
RUN apk add --no-cache \
    icu-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    libpng-dev \
    libjpeg-turbo-dev \
    libwebp-dev \
    zlib-dev \
    $PHPIZE_DEPS

# 2. 安裝 PHP 核心擴展 (包含 intl 與 Excel 所需的 gd)
RUN docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install \
        pdo_mysql \
        bcmath \
        zip \
        intl \
        gd

WORKDIR /var/www/html