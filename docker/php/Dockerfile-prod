# 使用 FPM 版本以支援 Nginx 連線
FROM php:8.2-fpm-alpine

# 1. 安裝系統依賴
RUN apk add --no-cache \
    icu-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    libpng-dev \
    libjpeg-turbo-dev \
    libwebp-dev \
    zlib-dev \
    $PHPIZE_DEPS

# 2. 安裝 PHP 核心擴展
RUN docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install \
        pdo_mysql \
        bcmath \
        zip \
        intl \
        gd \
        opcache

# 3. 正式環境的 opcache 建議設定(提升 PHP 效能)
RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.enable_cli=0'; \
        echo 'opcache.memory_consumption=128'; \
        echo 'opcache.max_accelerated_files=10000'; \
        echo 'opcache.validate_timestamps=1'; \
        echo 'opcache.revalidate_freq=60'; \
    } > /usr/local/etc/php/conf.d/opcache.ini

# 4. 從官方 composer image 取得 composer 執行檔(供容器內跑 composer install)
COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

# 設定工作目錄
WORKDIR /var/www/html

# 5. 只建立並調整「需要寫入權限」的目錄
RUN mkdir -p storage/app/public \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    public/images/references \
    public/pdfs/references \
    public/usage_results

# 6. 精準調整擁有者：只針對 storage 和上傳目錄
RUN chown -R www-data:www-data storage bootstrap/cache public/images public/pdfs public/usage_results

# 7. 設定權限：目錄 775, 檔案 664，確保組群內可寫入
RUN find storage bootstrap/cache public/images public/pdfs public/usage_results -type d -exec chmod 775 {} \; \
    && find storage bootstrap/cache public/images public/pdfs public/usage_results -type f -exec chmod 664 {} \;

# 預設啟動命令
CMD ["php-fpm"]
